# Respaldo diario cifrado de un cliente (D-025). Instancia = clave del cliente.
#   systemctl enable --now facturas-respaldos@GRUPO-DEMO.timer
[Unit]
Description=Respaldo cifrado del cliente %i
After=docker.service

[Service]
Type=oneshot
User=facturas-op
WorkingDirectory=/opt/facturas
Environment=SECRETOS_URL=http://127.0.0.1:8200 RESPALDOS_RED=facturas_control
ExecStart=/opt/facturas/venv/bin/python -m app.plataforma.respaldos respaldar --clave %i
