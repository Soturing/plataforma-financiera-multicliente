POSTGRES_DB=facturas_demo
POSTGRES_USER=facturas_app
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
POSTGRES_PORT=5432

# Plano de control compartido (sin datos financieros)
CONTROL_POSTGRES_DB=facturas_control
CONTROL_POSTGRES_USER=control_owner
CONTROL_POSTGRES_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LOCAL
CONTROL_POSTGRES_PORT=5433

# Backend (la contraseña debe coincidir con POSTGRES_PASSWORD)
FACTURAS_DATABASE_URL=postgresql://facturas_app:CAMBIAR_POR_UN_SECRETO_LOCAL@localhost:5432/facturas_demo
FACTURAS_CONTROL_DATABASE_URL=postgresql://control_owner:CAMBIAR_POR_OTRO_SECRETO_LOCAL@localhost:5433/facturas_control
FACTURAS_UPLOAD_DIR=data/uploads
FACTURAS_MAX_UPLOAD_BYTES=15728640
FACTURAS_MAX_PDF_PAGES=200

# OIDC del proveedor que implementará passkeys/WebAuthn. No se aceptan contraseñas locales.
FACTURAS_OIDC_IDENTITY_PROVIDER=proveedor-configurado
FACTURAS_OIDC_ISSUER=https://id.example.com/
FACTURAS_OIDC_AUDIENCE=https://api.example.com
FACTURAS_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
# Claim opcional emitido por el proveedor: FEDERATED, PASSKEY o HARDWARE_KEY.
FACTURAS_OIDC_AUTH_LEVEL_CLAIM=https://api.example.com/auth_level

# Registro local ignorado por Git. Cada archivo <referencia>.json contiene las
# credenciales y la raíz de archivos de un solo data plane.
FACTURAS_DATA_PLANE_CONFIG_DIR=config/tenants/private
