POSTGRES_DB=facturas_demo
POSTGRES_USER=facturas_app
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
POSTGRES_PORT=5432

# Backend (la contraseña debe coincidir con POSTGRES_PASSWORD)
FACTURAS_DATABASE_URL=postgresql://facturas_app:CAMBIAR_POR_UN_SECRETO_LOCAL@localhost:5432/facturas_demo
FACTURAS_UPLOAD_DIR=data/uploads
FACTURAS_MAX_UPLOAD_BYTES=104857600
FACTURAS_MAX_PDF_PAGES=200

# Cola de lectura (OCR). Cada worker carga su propio modelo en memoria.
FACTURAS_OCR_WORKERS=1
# true: el API levanta los workers si nadie está leyendo. En producción con
# servicio propio para los workers (python -m app.worker_cli), ponga false.
FACTURAS_OCR_AUTOSTART_WORKERS=true
FACTURAS_OCR_LEASE_SECONDS=120

# Proveedor de identidad (Keycloak, perfil `identidad` de compose). Sustituya
# cada CAMBIAR_* por un secreto aleatorio distinto. La cuenta de instalación
# sólo sirve para el arranque y se elimina al crear al primer director.
IDENTIDAD_PORT=8180
IDENTIDAD_DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
IDENTIDAD_ADMIN_USER=instalacion
IDENTIDAD_ADMIN_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
FACTURAS_OIDC_CLIENT_SECRET=CAMBIAR_POR_UN_SECRETO_LOCAL
FACTURAS_IDP_ADMIN_CLIENT_SECRET=CAMBIAR_POR_UN_SECRETO_LOCAL
FACTURAS_APP_URL=http://127.0.0.1:8010

# Plano de control (perfil `identidad`): base propia en 5436.
CONTROL_OWNER_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
CONTROL_APP_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
CONTROL_POSTGRES_PORT=5436
FACTURAS_CONTROL_DATABASE_URL=postgresql://control_app:CAMBIAR_POR_UN_SECRETO_LOCAL@127.0.0.1:5436/facturas_control

# Acceso: "abierto" conserva el uso sin sesión; "seguro" exige sesión en todo.
FACTURAS_ACCESO_MODO=abierto
FACTURAS_TENANT_CLAVE=GRUPO-DEMO
